# ========================================
# BUILD OUTPUTS & COMPILED FILES
# ========================================
**/bin/
**/obj/
**/out/
*.dll
*.exe
*.pdb

Dockerfile*
**/*.md

# ========================================
# DEVELOPMENT ARTIFACTS
# ========================================
.idea/
.vs/
.vscode/
*.suo

# ========================================
# NUGET PACKAGES (CPM already handles versions)
# ========================================
packages/
**.nupkg
**.snupkg
**/NuGet.config

# ========================================
# TEST FILES (not needed in production)
# ========================================
tests/
*.trx
coverage/
*.coveragexml
*.coverage

# ========================================
# DOCUMENTATION (exclude from containers)
# ========================================
*.md
README.md
CHANGELOG.md
docs/

# ========================================
# ENVIRONMENT & CONFIGURATION FILES
# ========================================
*.env
*.env.*

# Keep appsettings.json in container (runtime config)
# .opencode folder excluded from containers (development only)

# ========================================
# BUILD TOOLS & LOGS
# ========================================
nuget.config
*.log
*.txt
tmp/
temp/
*.tmp
*.cache

# ========================================
# OS-SPECIFIC FILES
# ========================================
.DS_Store
Thumbs.db

# ========================================
# DOCKER COMPOSE OVERRIDES
# ========================================
docker-compose.override.yml
