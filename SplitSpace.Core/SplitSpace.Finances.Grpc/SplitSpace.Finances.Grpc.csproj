<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SplitSpace.Finances.Grpc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Api.CommonProtos" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\SplitSpace\**\*.proto"
              GrpcServices="Server"
              AdditionalImportDirs="Protos"
              AdditionalImportArgs="--csharp_opt=nullable=on"/>
  </ItemGroup>

  <PropertyGroup>
    <IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
  </PropertyGroup>

</Project>
