{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "JwtOptions": {
    "Secret": "CHANGE_THIS_SECRET_KEY_IN_PRODUCTION_32_CHARS_MINIMUM",
    "Issuer": "SplitSpace.AuthService",
    "Audience": "SplitSpace.Clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "ConnectionStrings": {
    "AuthServiceDb": "Host=localhost;Database=auth_db;Username=postgres;Password=postgres",
    "FinanceServiceDb": "Host=localhost;Database=finance_db;Username=postgres;Password=postgres",
    "SpaceServiceDb": "Host=localhost;Database=space_db;Username=postgres;Password=postgres"
  }
}
