<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>SplitSpace.ExternalFacade.Grpc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" />
    <PackageReference Include="Google.Api.CommonProtos" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protos\SplitSpace\**\*.proto"
              GrpcServices="Client"
              AdditionalImportDirs="Protos"/>
  </ItemGroup>

  <PropertyGroup>
    <IncludeHttpRuleProtos>true</IncludeHttpRuleProtos>
  </PropertyGroup>

</Project>
